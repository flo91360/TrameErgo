{
  "$schema": "../gen/schemas/desktop-schema.json",
  "identifier": "default",
  "description": "Enregistrer les bilans dans Documents\\TrameErgo (sans écraser un bilan existant sans accord) et les ouvrir dans Word.",
  "windows": ["main"],
  "permissions": [
    "core:default",
    {
      "identifier": "fs:allow-mkdir",
      "allow": [{ "path": "$DOCUMENT/TrameErgo" }]
    },
    {
      "identifier": "fs:allow-exists",
      "allow": [{ "path": "$DOCUMENT/TrameErgo/*" }]
    },
    {
      "identifier": "fs:allow-write-file",
      "allow": [{ "path": "$DOCUMENT/TrameErgo/*" }]
    },
    {
      "identifier": "opener:allow-open-path",
      "allow": [{ "path": "$DOCUMENT/TrameErgo/*" }]
    }
  ]
}
